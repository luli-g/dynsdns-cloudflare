# Precedence: system environment variables (shell, systemd, Docker) always
# take precedence over values in this file. python-dotenv is loaded with
# override=False, so .env values are only used when the variable is not
# already set. In production, set credentials via the system environment;
# use this file for local development only.

# Required
CLOUDFLARE_API_TOKEN=your-api-token-here
ZONE_ID=your-zone-id-here
RECORD_NAME=sub.example.com

# Optional (defaults shown)
RECORD_TYPE=A
# LOG_FILE=/var/log/cloudflare-ddns.log
# LOG_LEVEL=INFO
